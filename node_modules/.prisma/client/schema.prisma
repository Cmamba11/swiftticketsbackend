generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         String   @default("Customer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizer Organizer?
  tickets   Ticket[]
}

model Organizer {
  id                   String              @id @default(cuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id])
  name                 String
  email                String?
  phone                String
  payoutProvider       String // orange_money | mtn_momo
  payoutNumber         String
  country              String              @default("LR")
  withdrawalsDisabled  Boolean             @default(false)
  riskLevel            String              @default("low") // low | medium | high
  negativeBalanceCount Int                 @default(0)
  wallet               OrganizerWallet?
  events               Event[]
  withdrawals          Withdrawal[]
  transactions         WalletTransaction[]
  ledgerEntries        WalletLedger[]
  createdAt            DateTime            @default(now())
}

model OrganizerWallet {
  id               String    @id @default(cuid())
  organizerId      String    @unique
  availableBalance Float     @default(0)
  pendingBalance   Float     @default(0)
  totalWithdrawn   Float     @default(0)
  updatedAt        DateTime  @updatedAt
  organizer        Organizer @relation(fields: [organizerId], references: [id])
}

model WalletLedger {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id])
  type        String // pending, available, withdrawal, platform_fee, refund, negative_balance
  amount      Float
  released    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WalletTransaction {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  type        String // credit | debit
  amount      Float
  reference   String
  description String
  createdAt   DateTime  @default(now())
}

model Withdrawal {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  amount      Float
  provider    String // orange_money | mtn_momo
  phone       String
  status      String // pending | approved | paid | failed
  createdAt   DateTime  @default(now())
}

model Event {
  id              String         @id @default(cuid())
  title           String
  description     String
  date            DateTime
  endDate         DateTime?
  location        String
  organizerId     String
  organizer       Organizer      @relation(fields: [organizerId], references: [id])
  category        String
  imageUrl        String
  status          String         @default("Draft") // Draft, Published, Cancelled
  cancelledAt     DateTime?
  reserveReleased Boolean        @default(false)
  ticketTypes     TicketType[]
  tickets         Ticket[]
  ledgerEntries   WalletLedger[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TicketType {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  name     String
  price    Float
  capacity Int
  sold     Int    @default(0)
}

model Ticket {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id])
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  ticketType    String
  ticketCode    String    @unique
  status        String    @default("Active") // Active, Scanned, Refunded
  pricePaid     Float
  scannedAt     DateTime?
  scannedGate   String?
  createdAt     DateTime  @default(now())
}
